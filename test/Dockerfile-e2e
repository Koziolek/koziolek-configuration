FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Warsaw

RUN apt-get update && \
    apt-get install -y \
    curl \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Lokalny katalog packages/ (skrypt + wspólne listy) zamiast curl z GitHub —
# testujemy bieżące zmiany.
COPY packages /packages
RUN chmod +x /packages/initial_packages_ubuntu.sh

# Domyślny CMD uruchamia pełny skrypt (jak oryginalne Dockerfile-test)
CMD ["/packages/initial_packages_ubuntu.sh"]
