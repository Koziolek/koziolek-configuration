FROM rockylinux:9

# --allowerasing: obraz bazowy ma curl-minimal, konfliktuje z pełnym curl.
RUN yum install -y --allowerasing \
    curl \
    sudo \
    && yum clean all

# Lokalny katalog packages/ (skrypt + wspólne listy) zamiast curl z GitHub —
# testujemy bieżące zmiany.
COPY packages /packages
RUN chmod +x /packages/initial_packages_redhat.sh

# Domyślny CMD uruchamia pełny skrypt (jak oryginalne Dockerfile-test)
CMD ["/packages/initial_packages_redhat.sh"]
